# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/

# ── Python tooling ───────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.prof

# ── Environment & secrets (NEVER commit) ─────────────────────────────────────
**/.env
**/.env.*
!**/.env.example
!backend/.env.test_empty
*.pem
*.key

# ── Runtime config (generated per-host) ──────────────────────────────────────
backend/data/integration_settings.json
.tsoc-install-progress
.tsoc-pip-trusted-host


# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.pid
setup.log
backend/logs/

# ── Caches & large model files ───────────────────────────────────────────────
backend/.cache/
.cache/
*.db
*.db-wal
*.db-shm

# ── Node.js / Frontend ──────────────────────────────────────────────────────
node_modules/
.next/
out/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── AI coding agents & assistants ────────────────────────────────────────────
# Cursor
.cursor/
.cursorrules
.cursorignore
.cursorindexingignore
# GitHub Copilot
.copilot/
.github/copilot-instructions.md
# Windsurf / Codeium
.windsurf/
.codeium/
# Aider
.aider*
# Cline
.cline/
.clinerules
# Augment
.augment*
# Tabnine
.tabnine*
# Continue
.continue/
# Amazon Q / CodeWhisperer
.aws/amazonq/
# Sourcegraph Cody
.cody/

# ── Local tooling ────────────────────────────────────────────────────────────
.tools/
.code-review-graph/
# Local-only: compare server vs GitHub (not for public repo)
scripts/git-sync-status.sh
scripts/.git-sync-status.out

# ── Internal engineering notes (not for public GitHub) ───────────────────────
project-engineering/

# ── Generated submission evidence (regenerate locally) ───────────────────────
submission/evidence/*
!submission/evidence/.gitkeep
