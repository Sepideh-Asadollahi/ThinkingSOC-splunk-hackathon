# Single-server layout — all services on 127.0.0.1 (see backend/.env.example)
AUTH_SECRET=change-me-to-a-long-random-string

TSOC_DEMO_USER=admin
TSOC_DEMO_PASSWORD=123456@a

# Backend proxy (server-side only; Next.js → FastAPI)
TSOC_BACKEND_URL=http://127.0.0.1:9876
TSOC_INGEST_TOKEN=
# Undici fetch timeouts (ms) for /api/backend/* → FastAPI
# TSOC_PROXY_TIMEOUT_MS=300000
# TSOC_PROXY_CHAT_TIMEOUT_MS=600000

# Browser origin for Next dev (HMR); comma-separate hosts you open in the browser
# Local: 127.0.0.1,localhost — LAN: add your server IP (e.g. 192.168.1.150)
TSOC_DEV_ORIGIN=127.0.0.1,localhost,192.168.1.150

# Optional UI hints (no secrets); match the URL you use in the browser
NEXT_PUBLIC_TSOC_APP_URL=http://192.168.1.150:3000
NEXT_PUBLIC_TSOC_SPLUNK_HOST=127.0.0.1
NEXT_PUBLIC_TSOC_SPLUNK_PORT=8089

# Correlation demo (Graph API via /api/backend → /api/v1/graph)
# NEXT_PUBLIC_USE_MOCK=true
