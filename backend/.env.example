# Copy to .env and fill in. Never commit .env.
#
# Dev layout: PostgreSQL + Qdrant + Neo4j in Docker, backend on host.
#   cd backend && docker compose up -d
#   python run.py
#
# All keys below are read from the environment (or backend/.env via python-dotenv).
# Names match pydantic-settings field names in config.Settings (UPPER_SNAKE_CASE).

# -----------------------------------------------------------------------------
# HTTP server (backend/run.py — not in Settings)
# -----------------------------------------------------------------------------
# Bind address for uvicorn when starting via `python run.py`
TSOC_HTTP_HOST=127.0.0.1
# Listen port; change if 9876 is already in use
TSOC_HTTP_PORT=9876
# Hot-reload on code changes (dev only)
TSOC_RELOAD=false
# If true, do not kill existing processes on TSOC_HTTP_PORT before bind
TSOC_RUN_NO_KILL=false
# If true, skip auto-starting Docker Postgres in run.py (you manage DB yourself)
TSOC_RUN_SKIP_POSTGRES=false
# Python logging level for the API process (main.py)
LOG_LEVEL=INFO
# Disable ANSI colors in analysis-complete console output
TSOC_LOG_NO_COLOR=false

# -----------------------------------------------------------------------------
# Splunk REST (management port 8089)
# -----------------------------------------------------------------------------
# Splunk mgmt URL for REST jobs, parser, AI Assistant /predict, etc.
SPLUNK_MGMT_URL=https://127.0.0.1:8089
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
# Verify TLS certificates when calling Splunk REST
SPLUNK_VERIFY_SSL=false
# REST namespace: servicesNS owner/app for oneshot job results
TSOC_SPLUNK_APP=search
TSOC_SPLUNK_OWNER=nobody
# App used for POST /search/v2/parser (must expose search REST; not Splunk_SA_CIM)
TSOC_SPL_PARSER_APP=search

# -----------------------------------------------------------------------------
# PostgreSQL (required for dashboard, ingest store, SOC chat SQL, RAG metadata)
# -----------------------------------------------------------------------------
TSOC_POSTGRES_DSN=postgresql://tsoc:tsoc@127.0.0.1:5432/tsoc

# -----------------------------------------------------------------------------
# Neo4j — graph correlation (/api/v1/graph, mounted in main backend)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tsoc-tsoc
CORRELATION_DEMO_API_KEY=dev-key
# CORRELATION_BEARER_TOKEN=
TSOC_CORRELATION_ENABLED=true
TSOC_CORRELATION_AUTO_SEED=true
# Attack Discovery clustering window (hours); default 168 = 7 days
# CORRELATION_CLUSTER_WINDOW_HOURS=168
# SMART_ANALYSIS_LOOKBACK_DAYS=7
# Optional entity taxonomy overrides (comma-separated types without colon)
# CORRELATION_ANCHOR_ENTITY_PREFIXES=username,hostname,host,asset
# CORRELATION_INDICATOR_ENTITY_PREFIXES=ipv4,domain,url,sha256

# -----------------------------------------------------------------------------
# Webhook ingest & alert routing
# -----------------------------------------------------------------------------
# Buffer webhook POSTs per Splunk sid (dedupe + debounce) before enrich/analyze (default on).
TSOC_INGEST_ROW_BUFFER=true
# Seconds after the last POST for a sid before flush (0.5–60).
TSOC_INGEST_ROW_BUFFER_SECONDS=3.0
# After webhook enrich: run agent triage in background (HTTP 202). Not overridable via URL.
TSOC_INGEST_AUTO_ANALYZE=true
# Pipeline when auto-analyze is on: triage | route | none
TSOC_INGEST_AUTO_ANALYZE_PIPELINE=triage
# Max Splunk result rows to triage per ingest job (sequential; storage sid gets -1, -2, …)
TSOC_INGEST_AUTO_ANALYZE_MAX_ROWS=50
# Log full Splunk webhook JSON to backend console (for payload format debugging)
TSOC_INGEST_LOG_RAW_WEBHOOK_BODY=true
# Optional Bearer token required on ingest routes (must match frontend TSOC_INGEST_TOKEN).
# Empty = no auth (default for local demos). Generate: openssl rand -hex 24
# See docs/11-environment-configuration.md#tsoc_ingest_token-optional-ingest-auth
TSOC_INGEST_TOKEN=
# Optional separate Bearer token for admin/settings routes (falls back to TSOC_INGEST_TOKEN when empty)
TSOC_ADMIN_TOKEN=
# Append each enriched webhook payload as one JSON line per file
TSOC_ALERT_LOG_PATH=
# LLM-only alert routing (manual_review when LLM unavailable)
TSOC_CLASSIFIER_LLM=true

# Simple in-process API rate limiting for sensitive routes
TSOC_RATE_LIMIT_ENABLED=true
TSOC_RATE_LIMIT_WINDOW_SECONDS=60
TSOC_RATE_LIMIT_MAX_REQUESTS=60

# -----------------------------------------------------------------------------
# LiteLLM (all SOC LLM calls — Defender/Hunter/Judge, SPL review, chat, SQL)
# -----------------------------------------------------------------------------
# Model id as LiteLLM understands it (e.g. gpt-4o-mini, anthropic/claude-3-5-haiku-20241022)
LITELLM_MODEL=gpt-4o-mini
# Optional; if unset, LiteLLM uses provider env keys below
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_TIMEOUT_SECONDS=120
# Process-wide maximum LLM requests per minute; excess calls wait for a slot.
LITELLM_RPM=30
# Retry transient provider failures three times after the initial attempt.
LITELLM_MAX_RETRIES=3
# Exponential retry delays: 5s, 10s, 20s (capped at 60s).
LITELLM_RETRY_BASE_SECONDS=5
LITELLM_RETRY_MAX_SECONDS=60
# Global cap on completion tokens per request (128k max)
LITELLM_MAX_TOKENS=131072
# Default temperature for POST /api/v1/llm/chat when body omits temperature (omit line = use code default 0.3)
# LITELLM_CHAT_DEFAULT_TEMPERATURE=0.3
# Provider API keys (used by LiteLLM when LITELLM_API_KEY is empty)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# SOC analysis (LangGraph Defender / Hunter / Judge)
# -----------------------------------------------------------------------------
# Optional JSONL log of each analysis record
TSOC_ANALYSIS_LOG_PATH=
# Max completion tokens for Defender/Hunter/Judge structured JSON
LITELLM_ANALYSIS_MAX_TOKENS=8192
# Temperature for analysis LLM calls
LITELLM_ANALYSIS_TEMPERATURE=0.2
# Effective model context window — drives prompt truncation budgets
TSOC_LLM_CONTEXT_TOKENS=131072
# Max chars of alert JSON embedded in per-question SPL prompts
TSOC_SPL_ALERT_CONTEXT_MAX_CHARS=32768
# Slim alert-only context in SPL LLM (no full analysis JSON)
TSOC_SPL_COMPACT_CONTEXT=true
# Max investigation follow-up questions per alert (LLM + SPL pipeline)
TSOC_INVESTIGATION_QUESTIONS_MAX=3
# After investigation SPL is drafted: SAIA optimize + explain via MCP in Analysis UI
TSOC_ANALYSIS_SAIA_SPL_REVIEW=true

# -----------------------------------------------------------------------------
# VirusTotal API v3 (IOC enrichment in analysis workflow)
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLE=true
VIRUSTOTAL_TIMEOUT_SECONDS=15
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
# Max IOCs (hash/ip/domain/url) queried per analysis
VIRUSTOTAL_MAX_IOCS=8

# -----------------------------------------------------------------------------
# Splunk MCP Server (Splunkbase app 7931) + SAIA tools
# -----------------------------------------------------------------------------
TSOC_MCP_ENABLED=true
# Full MCP JSON-RPC trace (no truncation) — logger tsoc.trace.mcp
TSOC_MCP_TRACE_LOG=false
# Full SAIA tool request/response trace — logger tsoc.trace.saia
TSOC_SAIA_TRACE_LOG=false
# Optional file for MCP+SAIA trace lines
TSOC_TRACE_LOG_FILE=
# MCP endpoint; default derives from SPLUNK_MGMT_URL + /services/mcp
SPLUNK_MCP_URL=
SPLUNK_MCP_TOKEN=
SPLUNK_MCP_VERIFY_SSL=false
SPLUNK_MCP_TIMEOUT_SECONDS=90
# Use MCP tools for cross-alert correlation during analysis
TSOC_MCP_CORRELATION_ENABLED=false
# Hunter/Judge LangGraph: live MCP hunt queries + SAIA ask before LLM reasoning
TSOC_MCP_HUNTER_JUDGE_ENABLED=true
# saia_generate_spl: false = full SAIA reply (reasoning + SPL, like Splunk UI)
TSOC_MCP_SAIA_SPL_ONLY=false
# After generate: run saia_optimize_spl then saia_explain_spl
TSOC_MCP_SAIA_OPTIMIZE_SPL=true
TSOC_MCP_SAIA_EXPLAIN_SPL=true
# Max chars for SAIA MCP prompt (Splunk hard limit 1000)
TSOC_SAIA_MCP_PROMPT_MAX_CHARS=1000
# LiteLLM writes the ≤1000-char SAIA prompt before MCP generate
TSOC_SAIA_LLM_PREPARE_PROMPT=true

# -----------------------------------------------------------------------------
# Investigation SPL generation & execution
# -----------------------------------------------------------------------------
# Generate SPL via Splunk AI Assistant REST /predict (UI-like path)
TSOC_SPL_USE_REST_PREDICT=true
# Auto-repair SAIA cloud_connected_configurations on startup and predict configs errors
TSOC_SAIA_AUTO_REPAIR=true
# Splunk install path (for splunk cmd python3 during SAIA token refresh)
SPLUNK_HOME=/opt/splunk
TSOC_SPL_PREDICT_TIMEOUT_SECONDS=90
TSOC_SPL_PREDICT_POLL_INTERVAL_SECONDS=0.75
# After predict/MCP: analysis LLM reviews and fixes SPL if needed
TSOC_SPL_LLM_REVIEW=true
# On parser/execute errors: pass error text to LiteLLM and re-validate
TSOC_SPL_LLM_REFINE_ON_ERROR=true
# After execute: refine on error or 0 rows (max loops per question, 0–3)
TSOC_SPL_EXECUTE_REFINE_MAX_ATTEMPTS=3
# Prefer MCP splunk_run_query; fallback to REST oneshot
TSOC_SPL_EXECUTE_VIA_MCP=true
# Default Splunk time range for investigation search jobs
TSOC_INVESTIGATION_SPL_TIME_WINDOW=earliest=1 latest=now
# Run investigation SPL against Splunk (false = generate only, no execute)
TSOC_EXECUTE_INVESTIGATION_SPL=true

# -----------------------------------------------------------------------------
# ThinkingSOC Lite — verified incident-to-runbook compiler
# -----------------------------------------------------------------------------
# Disable compile/approval/reuse while keeping existing artifacts readable.
TSOC_RUNBOOK_ENABLED=true
# Strict GPT compiler output cap (documented MVP range: 1–3).
TSOC_RUNBOOK_MAX_STEPS=3
# Editable analyst baseline used for target-run savings metrics (5–120 minutes).
TSOC_RUNBOOK_DEFAULT_MANUAL_MINUTES=25
# Bounded append-only lookup per ThinkingSOC Lite artifact type (50–1000).
TSOC_RUNBOOK_ARTIFACT_SCAN_LIMIT=500
# Evaluation economics. Set token prices for paid models; keep 0 for free models.
TSOC_RUNBOOK_ANALYST_HOURLY_COST_USD=65
TSOC_RUNBOOK_INPUT_COST_PER_1M_TOKENS=0
TSOC_RUNBOOK_OUTPUT_COST_PER_1M_TOKENS=0
# Bounded agent orchestration (read/compile/verify/preview only; no auto approval/response)
TSOC_RUNBOOK_AUTOPILOT_ENABLED=true

# -----------------------------------------------------------------------------
# SOC vector RAG (Qdrant + FastEmbed)
# -----------------------------------------------------------------------------
TSOC_VECTOR_ENABLE=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=tsoc_soc_rag

# --- TSOC_EMBEDDING_MODEL: uncomment ONE line (see docs/10-soc-vector-rag.md) ---
# Local ONNX embeddings via FastEmbed. Vector dimension is auto-detected at runtime.
# After changing model: restart backend; Qdrant collection is recreated if dim changes,
# then run backfill (TSOC_RAG_BACKFILL_ON_STARTUP=true or POST /api/v1/soc/rag/backfill).
# Pre-download without starting the API: bash scripts/download-embedding-model.sh
#
# Presets (recommended):
# TSOC_EMBEDDING_MODEL=bge-small    # BAAI/bge-small-en-v1.5 | ~33 MB  | 384-dim  | dev / slow internet
TSOC_EMBEDDING_MODEL=bge-base        # BAAI/bge-base-en-v1.5  | ~220 MB | 768-dim  | default / medium (install.sh)
# TSOC_EMBEDDING_MODEL=bge-large    # BAAI/bge-large-en-v1.5 | ~1.2 GB | 1024-dim | best quality, slow download
#
# Short aliases (same models as above):
# TSOC_EMBEDDING_MODEL=small
# TSOC_EMBEDDING_MODEL=base
# TSOC_EMBEDDING_MODEL=medium         # alias for bge-base
# TSOC_EMBEDDING_MODEL=large
#
# Full HuggingFace / FastEmbed ids:
# TSOC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# TSOC_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# TSOC_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Informational only — runtime uses dim from the model above (startup warns if mismatched)
TSOC_EMBEDDING_DIM=768
# ONNX model cache (Settings field; FASTEMBED_CACHE_PATH is an alias read by embeddings.py)
TSOC_FASTEMBED_CACHE_DIR=/opt/.thinking-soc-cache/fastembed
FASTEMBED_CACHE_PATH=
# Similar past alerts injected into analysis context
TSOC_RAG_SIMILAR_MAX=3
TSOC_RAG_SIMILAR_MIN_SCORE=0.35
TSOC_RAG_SIMILAR_LOOKBACK_DAYS=30
# Approx token budget for similar-alert snippets in prompts
TSOC_RAG_SIMILAR_TOKEN_BUDGET=1500
# Top-k chunks for SOC chat RAG retrieval
TSOC_RAG_CHAT_TOP_K=12
# On API startup: backfill Qdrant from PostgreSQL analysis rows + inventory + correlation
TSOC_RAG_BACKFILL_ON_STARTUP=true

# SOC Chat — persisted conversations (PostgreSQL tsoc_chat_*) + session RAG for long threads
# See docs/10-soc-vector-rag.md
TSOC_CHAT_HISTORY_DIRECT_MAX=12
TSOC_CHAT_HISTORY_RAG_TOP_K=8
TSOC_CHAT_HISTORY_RECENT_TAIL=4

# -----------------------------------------------------------------------------
# SOC chat Text-to-SQL (statistical questions: counts, breakdowns)
# -----------------------------------------------------------------------------
TSOC_CHAT_SQL_ENABLE=true
TSOC_CHAT_SQL_MAX_ROWS=500
TSOC_CHAT_SQL_TIMEOUT_SECONDS=5
# Max tokens for SQL-generation LLM (thinking models need headroom)
TSOC_CHAT_SQL_MAX_TOKENS=131072
# Max tokens for “is this statistical?” classifier
TSOC_CHAT_SQL_CLASSIFY_MAX_TOKENS=2560
# Max tokens for natural-language answer over large SQL result sets
TSOC_CHAT_SQL_ANSWER_MAX_TOKENS=2048
# Optional separate model for SQL gen (non-thinking instruct model recommended)
TSOC_CHAT_SQL_MODEL=

# -----------------------------------------------------------------------------
# Live Splunk integration tests (pytest — optional, dev/CI only)
# -----------------------------------------------------------------------------
# TSOC_RUN_SPLUNK_LIVE=1
# TSOC_LIVE_API_BASE=http://127.0.0.1:9876
# TSOC_LIVE_SKIP_METADATA=1
